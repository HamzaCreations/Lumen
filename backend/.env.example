# Copy to backend/.env. All values can also be set as real environment vars.
# Never commit the filled-in .env: it contains your API key.

# --- Real generation (default) ---------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint works. Common bases:
#   OpenAI       https://api.openai.com/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Groq         https://api.groq.com/openai/v1
#                Chat models (verified live 2026-11-08):
#                  openai/gpt-oss-120b  <- best for grounded RAG, 131k ctx
#                  openai/gpt-oss-20b   <- faster, 131k ctx
#                  qwen/qwen3.8-27b     <- fastest, 131k ctx
#   DeepSeek     https://api.deepseek.com/v1
#   Together     https://api.together.xyz/v1
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai
#   HF router    https://router.huggingface.co/v1
#   SiliconFlow  https://api.siliconflow.cn/v1
#   LM Studio    http://localhost:1234/v1
RAG_LLM_BACKEND=api
RAG_API_KEY=
RAG_API_BASE=https://api.openai.com/v1
RAG_API_MODEL=gpt-4o-mini
RAG_API_TEMPERATURE=0
RAG_API_TIMEOUT=120
RAG_LLM_MAX_NEW_TOKENS=300
# RAG_API_KEY also falls back to a plain OPENAI_API_KEY environment variable.

# --- Alternative backends ---------------------------------------------------
# local  = notebook-faithful Qwen/Qwen2.5-1.5B-Instruct via transformers
#          (~3.09 GB download, greedy, slow on CPU)
# ollama = Qwen quantized by a local Ollama daemon (fast on CPU)
# hf     = Hugging Face Inference API
# Set RAG_LLM_BACKEND to one of those to switch away from `api`.
RAG_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
RAG_LLM_DEVICE=auto
RAG_LLM_LOAD_ON_STARTUP=false
RAG_OLLAMA_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen2.5:1.5b
RAG_HF_TOKEN=
RAG_HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# --- Retrieval --------------------------------------------------------------
# MUST match build_index.py / the notebook. Changing these requires a rebuild:
#   python scripts/build_index.py
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_MAX_LENGTH=256
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_K=3
RAG_DEFAULT_MIN_SCORE=0.40
RAG_HYBRID_CANDIDATES=20

RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
